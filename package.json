{
  "name": "meaning-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "explainer:data": "node scripts/run.mjs scripts/build-explainer-data.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@types/node": "26.6.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "ai": "^7.0.162",
    "dataloader": "^2.2.3",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "next": "16.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sentence-splitter": "^5.0.1",
    "typescript": "7.0.2",
    "unified": "^11.0.5",
    "workers-ai-provider": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.157.0",
    "yaml": "^2.9.1"
  }
}
