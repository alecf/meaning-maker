{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!.next", "!node_modules", "!public"]
  },
  // The formatter is enforced in CI via `biome check`; the repo was reformatted
  // in one pass when it was turned on.
  // Spaces/2 rather than Biome's default tabs, to match how the codebase was
  // already written.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  // Assist (import sorting) stays off: it rewrites import order, which is a
  // separate (and noisier) change than formatting.
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "domains": {
      // "all" rather than "recommended": the Next domain's recommended subset
      // omits noSyncScripts, which next/core-web-vitals treated as an error.
      "next": "all",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        // next/core-web-vitals enabled no equivalent; the two sites are
        // required-env-var reads in src/util/db.ts.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // react/jsx-key (which next did enable) only requires that a key be
        // present, not that it be stable. Opt in separately if wanted.
        "noArrayIndexKey": "off"
      },
      "a11y": {
        // next enabled only 5 jsx-a11y aria rules, not label association.
        "noLabelWithoutControl": "off"
      }
    }
  }
}
