{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meaning-maker",
	// OpenNext build output; don't change unless the build output changes.
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Workers AI always runs remotely, even in local dev (`next dev`,
	// `npm run preview`), so local dev needs `wrangler login` and incurs usage.
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			// No `id`: Wrangler auto-provisions a namespace named
			// "meaning-maker-embed-cache" on the first deploy and reuses it on
			// later deploys. Locally it is simulated and persisted in .wrangler/.
			"binding": "EMBED_CACHE"
		}
	],
	// Settings for `wrangler preview`, which Workers Builds runs on PR branches.
	// Bindings aren't inherited. The KV cache is left out so previews can't
	// write to production's cache; the API route runs uncached without it.
	"previews": {
		"ai": {
			"binding": "AI"
		}
	}
}
